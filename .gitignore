# Build output. Anchored on purpose: the copied SDK has build/ and lib/build/
# folders holding prebuilt libraries the project links against
# (liblinklayer.a, libbgcommon.a), which must stay tracked.
/build/
/bt_rcp_freertos_cmake/build/
/GNU ARM*/
/IAR ARM*/
/artifact/

# Firmware images and link outputs created outside the build folders
# (e.g. `commander gbl create app.gbl ...` in the project root).
/*.gbl
/*.s37
/*.hex
/*.bin
/*.axf
/*.out
/*.map

# Machine-specific toolchain paths, regenerated by slc
bt_rcp_freertos_cmake/autogen_toolchain.cmake

# Simplicity Studio / Eclipse workspace metadata (regenerated on import)
.project
.cproject
.settings/
.projectlinkstore
.uceditor/
.trash/
*.launch
.metadata/

# OS / editor
.DS_Store
Thumbs.db
*~
*.swp

# Python tooling
__pycache__/
*.pyc
.venv/

# Claude Code per-user settings
.claude/settings.local.json
