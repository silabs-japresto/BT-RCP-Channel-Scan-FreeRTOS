# Simplicity Studio 6 recommendations
# (https://docs.silabs.com/ssv6ug/latest/ssv6-tricks-tips/). These files are
# regenerated from bt_rcp_freertos.slcp. After cloning, open or regenerate the
# project in Simplicity Studio (or run slc generate) before building.
# *.md and *.png from that example are left out on purpose, so the project
# docs and readme images stay tracked.
autogen/
simplicity_sdk*/
.projectlinkstore
cmake_gcc/build/
bt_rcp_freertos_cmake/build/
*.cmake
CMakePresets.json
*.conf
.vscode/
artifacts/
trashed_modified_files/

# Other build output
/build/
/GNU ARM*/
/IAR ARM*/

# Firmware images created in the project root (e.g. commander gbl create app.gbl)
/*.gbl
/*.s37
/*.hex
/*.bin
/*.axf
/*.out
/*.map

# Eclipse-style workspace metadata
.project
.cproject
.settings/
.uceditor/
.trash/
*.launch
.metadata/

# OS / editor
.DS_Store
Thumbs.db
*~
*.swp

# Python tooling
__pycache__/
*.pyc
.venv/

# Claude Code per-user settings
.claude/settings.local.json
